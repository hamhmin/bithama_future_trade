// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  nickname         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  wallet           Wallet?
  positions        Position[]
  orders           Order[]
  fundingHistories FundingHistory[]
  symbolSettings UserSymbolSetting[]
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Float    @default(0)
  locked    Float    @default(0)
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
}

model Position {
  id               Int              @id @default(autoincrement())
  userId           Int
  symbol           String           @default("BTCUSDT")
  side             String           // "long" | "short"
  size             Float            // BTC 수량
  entryPrice       Float
  leverage         Int              @default(10)
  margin           Float            // 투입 증거금 (USDT)
  liquidationPrice Float
  marginType       String           @default("isolated")
  status           String           @default("open")
  pnl              Float            @default(0)
  user             User             @relation(fields: [userId], references: [id])
  orders           Order[]
  fundingHistories FundingHistory[]
  takeProfit Float?
  stopLoss   Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Order {
  id         Int       @id @default(autoincrement())
  userId     Int
  positionId Int?
  symbol     String    @default("BTCUSDT")
  side       String    // "long" | "short"
  type       String    // "market" | "limit"
  price      Float?
  size       Float
  leverage   Int       @default(10)
  margin     Float
  marginType String    @default("isolated")
  status     String    @default("open")
  user       User      @relation(fields: [userId], references: [id])
  position   Position? @relation(fields: [positionId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fee       Float?   // 수수료 금액
  feeType   String?  // "maker" | "taker"
  orderRole  String?  // "open" | "close"


}

model FundingHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  positionId Int
  amount     Float
  rate       Float
  user       User     @relation(fields: [userId], references: [id])
  position   Position @relation(fields: [positionId], references: [id])
  createdAt  DateTime @default(now())
}

model Candle {
  id       Int    @id @default(autoincrement())
  symbol   String
  interval String
  openTime BigInt
  open     Float
  high     Float
  low      Float
  close    Float
  volume   Float

  @@unique([symbol, interval, openTime])
  @@index([symbol, interval, openTime]) 

}

model UserSymbolSetting {
  id         Int      @id @default(autoincrement())
  userId     Int
  symbol     String   @default("BTCUSDT")
  marginType String   @default("isolated")
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, symbol])
}